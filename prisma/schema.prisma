generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  username     String              @unique
  displayName  String
  passwordHash String?
  role         String              @default("USER")
  avatarUrl    String?
  createdAt    DateTime            @default(now())
  projects     Project[]
  comments     Comment[]
  likes        Like[]
  sessions     Session[]
  submissions  ContestSubmission[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  description    String?
  objectName     String?
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  versions       MediaVersion[]
  comments       Comment[]
  likes          Like[]
  contestEntries ContestSubmission[]

  @@index([authorId, updatedAt])
}

model MediaVersion {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int
  note           String?
  originalName   String
  mimeType       String
  mediaKind      String
  byteSize       Int
  sha256         String
  storageKey     String
  previewUrl     String?
  width          Int?
  height         Int?
  capturedAt     DateTime?
  equipmentJson  String?
  plateSolveJson String?
  createdAt      DateTime  @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Like {
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
}

model Contest {
  id           String              @id @default(cuid())
  slug         String              @unique
  title        String
  description  String
  startsAt     DateTime
  endsAt       DateTime
  votingEndsAt DateTime
  createdAt    DateTime            @default(now())
  submissions  ContestSubmission[]
}

model ContestSubmission {
  contestId   String
  projectId   String
  userId      String
  contest     Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime      @default(now())
  votes       ContestVote[]

  @@id([contestId, projectId])
  @@index([contestId, submittedAt])
}

model ContestVote {
  contestId  String
  projectId  String
  userId     String
  submission ContestSubmission @relation(fields: [contestId, projectId], references: [contestId, projectId], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@id([contestId, projectId, userId])
  @@unique([contestId, userId])
}
